# Widgetly Backend Environment Configuration
# Copy this file to .env and fill in the values.

# Database
# SQLite is fine for development; use PostgreSQL for production
DATABASE_URL=sqlite:///widgetly.db

# Security
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encryption key for sensitive health data (optional, auto-generated if not set)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# OpenAI API (required for AI-powered widget generation)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model (default: gpt-4o-mini)
# Other options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap API (required for weather widgets)
# Get your key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Rate limiting (default: 100 requests per minute)
# Format: <number>/<period> where period is second, minute, hour, or day
RATE_LIMIT=100/minute